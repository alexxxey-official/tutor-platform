TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_ID=your_personal_chat_id_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Название модели Gemini
# Можно менять в любой момент (например: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3.1-pro-preview

# Путь к твоему проекту, который агенты будут редактировать
PROJECT_ROOT_PATH=/path/to/your/tutor-platform