TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_ID=your_personal_chat_id_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Название модели Gemini (например: gemini-2.5-pro, gemini-3.1-pro-preview и т.д.)
# Можно менять в любой момент
GEMINI_MODEL=gemini-2.0-flash

# Путь к твоему проекту, который агенты будут редактировать
PROJECT_ROOT_PATH=/path/to/your/tutor-platform